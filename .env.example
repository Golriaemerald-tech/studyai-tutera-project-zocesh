# Copy this file to .env.local for local `vercel dev` usage.
# NEVER commit your real key. In production, set this in the
# Vercel Project → Settings → Environment Variables instead.

GEMINI_API_KEY=your_gemini_api_key_here

# Optional — defaults to gemini-3.5-flash-lite if unset. This is the FIRST
# model tried. If it's overloaded, rate-limited, or not available on your
# key, /api/chat automatically falls back through a chain of other Gemini
# models (2.5-flash-lite, 2.5-flash, 2.0-flash-lite, 2.0-flash, 1.5-flash,
# 1.5-flash-8b) before giving up — this matters a lot on a free API key,
# which has low per-model rate limits.
GEMINI_MODEL=gemini-3.5-flash-lite
