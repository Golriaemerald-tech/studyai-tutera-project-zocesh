import React from 'react';
import { Link } from 'react-router-dom';
import { Shield, FileText } from 'lucide-react';

export default function AdminDashboard() {
 return <main className="mx-auto max-w-5xl p-4 sm:p-6"><div className="flex items-center gap-3"><Shield size={28}/><h1 className="text-2xl font-bold">Admin Dashboard</h1></div><p className="mt-2 text-white/50">Administration workspace.</p><div className="mt-6 grid gap-4 sm:grid-cols-2"><Link to="/admin/reports" className="rounded-2xl border border-white/10 bg-white/5 p-5 hover:bg-white/10"><FileText size={24}/><h2 className="mt-3 font-semibold">Reports</h2><p className="mt-1 text-sm text-white/50">Review administrative reports.</p></Link><div className="rounded-2xl border border-white/10 bg-white/5 p-5"><h2 className="font-semibold">Moderation</h2><p className="mt-2 text-sm text-white/50">Administration moderation tools can be connected here.</p></div></div></main>;
}
