import React from 'react';
import { Link } from 'react-router-dom';
import { Crown, Shield, BarChart3, Settings, Users } from 'lucide-react';

export default function OwnerDashboard() {
  const cards = [
    { title: 'Security', text: 'Manage platform security and access controls.', to: '/owner/security', icon: Shield },
    { title: 'Analytics', text: 'View platform activity and performance.', to: '/owner/analytics', icon: BarChart3 },
    { title: 'Owner Settings', text: 'Configure owner-level platform settings.', to: '/owner/settings', icon: Settings },
    { title: 'Super Admin Area', text: 'Open the wider administration controls.', to: '/superadmin', icon: Users },
  ];
  return <Page title="Owner Dashboard" subtitle="Full platform ownership and control.">
    <div className="grid gap-4 sm:grid-cols-2">
      {cards.map(({title,text,to,icon:Icon}) => <Link key={to} to={to} className="rounded-2xl border border-white/10 bg-white/5 p-5 transition hover:bg-white/10">
        <Icon size={24} />
        <h2 className="mt-3 font-semibold">{title}</h2>
        <p className="mt-1 text-sm text-white/50">{text}</p>
      </Link>)}
    </div>
  </Page>;
}

function Page({title,subtitle,children}:{title:string;subtitle:string;children:React.ReactNode}) {
 return <main className="mx-auto max-w-5xl p-4 sm:p-6"><div className="mb-6"><div className="flex items-center gap-3"><Crown size={28}/><h1 className="text-2xl font-bold">{title}</h1></div><p className="mt-2 text-white/50">{subtitle}</p></div>{children}</main>;
}
