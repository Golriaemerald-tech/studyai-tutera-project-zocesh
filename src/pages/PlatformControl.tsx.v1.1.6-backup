import React from 'react';
import { Link } from 'react-router-dom';
import { Settings, ArrowLeft } from 'lucide-react';

export default function PlatformControl() {
 return <main className="mx-auto max-w-5xl p-4 sm:p-6"><div className="flex items-center gap-3"><Settings size={28}/><h1 className="text-2xl font-bold">Platform Control</h1></div><p className="mt-2 text-white/50">Super Admin platform controls.</p><div className="mt-6 grid gap-4 sm:grid-cols-2"><Card title="System Status" text="Review application services and platform health."/><Card title="Feature Controls" text="Manage future platform feature switches."/><Card title="Moderation" text="Review account and community moderation workflows."/><Card title="Maintenance" text="Prepare controlled maintenance operations." /></div><Link to="/superadmin" className="mt-6 inline-flex items-center gap-2 text-sm text-white/60 hover:text-white"><ArrowLeft size={16}/> Back</Link></main>;
}
function Card({title,text}:{title:string;text:string}){return <div className="rounded-2xl border border-white/10 bg-white/5 p-5"><h2 className="font-semibold">{title}</h2><p className="mt-2 text-sm text-white/50">{text}</p></div>;}
